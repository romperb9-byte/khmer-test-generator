# Supabase Configuration (Required for cloud database persistence)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Admin Login Credentials (for adding/managing schools on Home Page)
VITE_ADMIN_USERNAME="admin"
VITE_ADMIN_PASSWORD="admin123"

# Optional default Gemini API Key (users can also enter their own Free API key in the UI)
VITE_GEMINI_API_KEY=""
GEMINI_API_KEY=""

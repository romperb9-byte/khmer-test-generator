 type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"1Remix Khmer Test Generator (\341\236\200\341\236\230\341\237\222\341\236\230\341\236\234\341\236\267\341\236\222\341\236\270\341\236\224\341\236\204\341\237\222\341\236\200\341\236\276\341\236\217\341\236\217\341\237\201\341\236\237\341\237\222\341\236\212)\",\n  \"description\": \"An AI-powered application to generate monthly and semester tests for grades 1-12 in Khmer, with multiple question types and balanced difficulty levels.\",\n  \"requestFramePermissions\": [\n    \"camera\"\n  ],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useRef, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport ReactMarkdown from \'react-markdown\';\nimport remarkMath from \'remark-math\';\nimport rehypeKatex from \'rehype-katex\';\nimport \'katex/dist/katex.min.css\';\nimport { saveAs } from \'file-saver\';\nimport { \n  FileText, \n  Settings, \n  Plus, \n  Trash2, \n  Loader2, \n  X, \n  AlertCircle,\n  Download,\n  Star,\n  Sun,\n  Cloud,\n  Palette,\n  CloudRain,\n  Rocket,\n  Zap,\n  Globe,\n  Atom,\n  Cpu,\n  Telescope,\n  FileSpreadsheet,\n  FileCode,\n  Camera,\n  ArrowRight,\n  Sparkles\n} from \'lucide-react\';\nimport { Difficulty, QuestionType, TestGeneratorOptions, GeneratedTest, Question } from \'./types.ts\';\nimport { generateTest } from \'./services/geminiService.ts\';\nimport { exportToWord } from \'./services/wordExport.ts\';\nimport { exportToCSV } from \'./services/csvExport.ts\';\nimport { generateGoogleFormScript } from \'./services/googleFormExport.ts\';\nimport { GoogleFormModal } from \'./components/GoogleFormModal.tsx\';\nimport { OmrScanner } from \'./components/OmrScanner.tsx\';\nimport { StudentOmrSheet } from \'./components/StudentOmrSheet.tsx\';\nimport { preprocessMathForDisplay } from \'./utils/mathUtils.ts\';\n\nconst GRADES = Array.from({ length: 12 }, (_, i) => `\341\236\220\341\237\222\341\236\223\341\236\266\341\236\200\341\237\213\341\236\221\341\236\270 ${i + 1}`);\nconst SUBJECTS = [\'\341\236\227\341\236\266\341\236\237\341\236\266\341\236\201\341\237\222\341\236\230\341\237\202\341\236\232\', \'\341\236\202\341\236\216\341\236\267\341\236\217\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\232\341\236\274\341\236\224\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\202\341\236\270\341\236\230\341\236\270\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\207\341\236\270\341\236\234\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\224\341\237\222\341\236\232\341\236\234\341\236\217\341\237\222\341\236\217\341\236\267\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\227\341\236\274\341\236\230\341\236\267\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\', \'\341\236\237\341\236\270\341\236\233\341\236\222\341\236\230\341\237\214-\341\236\226\341\236\233\341\236\232\341\236\212\341\237\222\341\236\213\', \'\341\236\227\341\236\266\341\236\237\341\236\266\341\236\224\341\236\232\341\236\221\341\237\201\341\236\237\'];\n\nexport default function App() {\n  const [grade, setGrade] = useState(GRADES[11]);\n  const [subject, setSubject] = useState(SUBJECTS[1]);\n  const [material, setMaterial] = useState(\'\');\n  const [images, setImages] = useState<string[]>([]);\n  const [questionCounts, setQuestionCounts] = useState<{ [key in QuestionType]?: number }>({\n    [QuestionType.MULTIPLE_CHOICE]: 5,\n    [QuestionType.SHORT_ANSWER]: 2,\n  });\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [showGoogleFormModal, setShowGoogleFormModal] = useState(false);\n  const [googleFormExport, setGoogleFormExport] = useState<{ gsCode: string; htmlCode: string; googleFormCode: string } | null>(null);\n  const [test, setTest] = useState<GeneratedTest | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [activeMode, setActiveMode] = useState<\'generator\' | \'omr\'>(\'generator\');\n  const [studentOmrData, setStudentOmrData] = useState<{\n    questionCount: number;\n    answerType: \'ABCD\' | \'KHKK\';\n    testTitle: string;\n    rawHash: string;\n  } | null>(null);\n\n  useEffect(() => {\n    const parseHash = () => {\n      try {\n        const hash = window.location.hash;\n        if (hash.startsWith(\'#share-omr=\')) {\n          const base64Data = hash.substring(\'#share-omr=\'.length);\n          const binaryStr = atob(base64Data);\n          const bytes = new Uint8Array(binaryStr.length);\n          for (let i = 0; i < binaryStr.length; i++) {\n            bytes[i] = binaryStr.charCodeAt(i);\n          }\n          const decodedString = new TextDecoder().decode(bytes);\n          const parsed = JSON.parse(decodedString);\n          if (parsed && typeof parsed.questionCount === \'number\') {\n            setStudentOmrData({\n              questionCount: parsed.questionCount,\n              answerType: parsed.answerType || \'ABCD\',\n              testTitle: parsed.testTitle || \'\341\236\234\341\236\267\341\236\211\341\237\222\341\236\211\341\236\266\341\236\237\341\236\266 OMR\',\n              rawHash: hash\n            });\n          }\n        } else {\n          setStudentOmrData(null);\n        }\n      } catch (e) {\n        console.error(\'Error parsing student OMR hash:\', e);\n      }\n    };\n\n    parseHash();\n    window.addEventListener(\'hashchange\', parseHash);\n    return () => window.removeEventListener(\'hashchange\', parseHash);\n  }, []);\n  const testRef = useRef<HTMLDivElement>(null);\n\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const files = e.target.files;\n    if (!files) return;\n\n    Array.from(files).forEach(file => {\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        setImages(prev => [...prev, reader.result as string]);\n      };\n      reader.readAsDataURL(file as Blob);\n    });\n  };\n\n  const removeImage = (index: number) => {\n    setImages(prev => prev.filter((_, i) => i !== index));\n  };\n\n  const toggleQuestionType = (type: QuestionType) => {\n    setQuestionCounts(prev => {\n      const newCounts = { ...prev };\n      if (newCounts[type]) {\n        delete newCounts[type];\n      } else {\n        newCounts[type] = 5;\n      }\n      return newCounts;\n    });\n  };\n\n  const updateCount = (type: QuestionType, count: number) => {\n    setQuestionCounts(prev => ({ ...prev, [type]: count }));\n  };\n\n  const handleGenerate = async () => {\n    if (!material && images.length === 0) {\n      setError(\'\341\236\237\341\236\274\341\236\230\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\242\341\236\217\341\237\222\341\236\220\341\236\224\341\236\221 \341\236\254\341\236\232\341\236\274\341\236\224\341\236\227\341\236\266\341\236\226\341\236\230\341\237\201\341\236\232\341\237\200\341\236\223\341\236\207\341\236\266\341\236\230\341\236\273\341\236\223\341\236\237\341\236\267\341\236\223!\');\n      return;\n    }\n    \n    setIsGenerating(true);\n    setError(null);\n    try {\n      const options: TestGeneratorOptions = {\n        grade,\n        subject,\n        material,\n        images,\n        questionCounts,\n        difficultyDistribution: {\n          [Difficulty.EASY]: 20,\n          [Difficulty.MEDIUM]: 60,\n          [Difficulty.HARD]: 20,\n        }\n      };\n      const result = await generateTest(options);\n      \n      // Sort questions based on the requested order\n      const typeOrder = [\n        QuestionType.TRUE_FALSE,\n        QuestionType.MATCHING,\n        QuestionType.MULTIPLE_CHOICE,\n        QuestionType.FILL_BLANKS,\n        QuestionType.SHORT_ANSWER,\n        QuestionType.LONG_ANSWER\n      ];\n\n      const sortedQuestions = [...result.questions].sort((a, b) => {\n        const indexA = typeOrder.indexOf(a.type);\n        const indexB = typeOrder.indexOf(b.type);\n        return indexA - indexB;\n      });\n\n      setTest({ ...result, questions: sortedQuestions });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'\341\236\230\341\236\266\341\236\223\341\236\224\341\236\211\341\237\222\341\236\240\341\236\266\341\236\224\341\236\205\341\237\222\341\236\205\341\237\201\341\236\200\341\236\221\341\237\201\341\236\237\341\237\224 \341\236\237\341\236\274\341\236\230\341\236\226\341\237\222\341\236\231\341\236\266\341\236\231\341\236\266\341\236\230\341\236\230\341\237\222\341\236\212\341\236\204\341\236\221\341\237\200\341\236\217!\');\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const handleCreateGoogleForm = () => {\n    if (!test) return;\n    const exportData = generateGoogleFormScript(test);\n    setGoogleFormExport(exportData);\n    setShowGoogleFormModal(true);\n  };\n\n  const handleExportCSV = () => {\n    if (!test) return;\n    exportToCSV(test);\n  };\n\n  const getDuration = () => {\n    const gradeNum = parseInt(grade.replace(\'\341\236\220\341\237\222\341\236\223\341\236\266\341\236\200\341\237\213\341\236\221\341\236\270 \', \'\')) || 0;\n    return gradeNum <= 6 ? 40 : 60;\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Kantumruy+Pro:wght@400;700&family=Khmer+OS+Freehand&family=Khmer+OS+Mool+Light&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", \"Kantumruy Pro\", ui-sans-serif, system-ui, sans-serif;\n  --color-brand-primary: #2563eb;\n  --color-brand-secondary: #1e293b;\n  --color-brand-background: #f8fafc;\n}\n\n@layer base {\n  body {\n    @apply bg-brand-background text-slate-900 antialiased;\n  }\n  \n  .markdown-body p {\n    @apply m-0;\n  }\n  \n  .markdown-body .katex-display {\n    @apply my-2 overflow-x-auto;\n  }\n  \n  .markdown-body .katex {\n    @apply text-[1.1em] leading-none;\n  }\n\n  .pdf-content {\n    @apply p-8 bg-white text-black;\n  }\n\n  .young-grade-decor {\n    @apply border-8 border-blue-100 rounded-[3rem] p-10 bg-white shadow-none;\n  }\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig, loadEnv} from \'vite\';\n\nexport default defineConfig(({mode}) => {\n  const env = loadEnv(mode, \'.\', \'\');\n  return {\n    plugins: [react(), tailwindcss()],\n    define: {\n      \'process.env.GEMINI_API_KEY\': JSON.stringify(env.GEMINI_API_KEY),\n    },\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n    },\n  };\n});\n\n```"
